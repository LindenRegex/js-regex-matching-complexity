+Section LexSatReduction.
+  Context {params: LindenParameters}.
   Context (a_char semicolon_char z_char: Parameters.Character).
+
+  Definition lexsat_qbf (nv: nat) (pf: pos_formula): qbf :=
+    (List.repeat Qbf.Exists nv, PosForm pf).
