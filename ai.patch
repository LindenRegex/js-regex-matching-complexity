+      (forall b cs, res (b :: cs) = res' cs) -> optp_spec n res' o -> optp_spec (S n) res o.
+  Proof.
+    intros; replace o with (seqop o o) by now destruct o.
+    apply optp_spec_choice with (res1 := res') (res2 := res'); auto.
+  Qed.
