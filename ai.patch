+    intros ? m Hq k; induction k as [|k IH]; intro v; size_cbn_poslk;
+      [rewrite Hq; cbn [RegexEncoding.check_formula_regex]; rewrite rev_repeat;
+       pose proof check_conjunct_negvar_size m
+      |pose proof (IH (S v))]; size_cbn_poslk; lia.
+  Qed.
