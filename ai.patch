+  Lemma optp_spec_done n res o:
+      (forall b cs, res (b :: cs) = res_of o) -> optp_spec (S n) res o.
+  Proof.
+    intro EQ; apply optp_spec_step with (res' := fun _ => res_of o);
+      auto using optp_spec_const.
+  Qed.
+
