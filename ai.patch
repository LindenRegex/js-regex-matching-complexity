+  Lemma from_int_ok (z: Z): (0 <= z)%Z ->
+      (NonNegInt.from_int z: Result.Result _ MatchError) = Success (Z.to_nat z).
+  Proof. intro LE; unfold NonNegInt.from_int; now rewrite (proj2 (Z.geb_le z 0) LE). Qed.
