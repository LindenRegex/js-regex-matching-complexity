+  Definition ngroups_form: nat := match snd q with PosForm _ => 0 | NegForm _ => 1 end.
+
+  Fixpoint ngroups_poslk (ql: list quantifier): nat :=
+    match ql with
+    | nil => ngroups_form
+    | Qbf.Exists::ql => S (ngroups_poslk ql)
+    | Qbf.NotExists::ql => S (S (ngroups_poslk ql))
