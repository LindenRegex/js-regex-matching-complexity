+        guess; intros NM; cbn; [exfalso; rewrite EL in NM; apply NM, S1; assumption
+                              | apply MAX; [assumption|]; now rewrite ER in NM].
+      + guess; [rewrite EL; apply S1 | rewrite ER; apply S2]; assumption.
+  Qed.
